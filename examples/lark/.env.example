# copy to .env and fill in

# port the connector listens on
CONNECTOR_PORT=4100

# the bearer Atlas presents on every POST. 32+ chars: openssl rand -hex 24
ATLAS_CONNECTOR_TOKEN=replace-with-a-random-secret-of-32-or-more-chars

# lark open platform: custom app credentials (open.larksuite.com developer console)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxxx
LARK_APP_SECRET=

# the Base (bitable) this connector serves: the app_token from the base's url
# https://xxx.larksuite.com/base/<app_token>?table=...
LARK_APP_TOKEN=

# open.larksuite.com (international) or open.feishu.cn (china)
LARK_DOMAIN=https://open.larksuite.com
