# copy to .env and fill in

# port the connector listens on
CONNECTOR_PORT=4100

# the bearer Atlas presents on every POST. 32+ chars: openssl rand -hex 24
ATLAS_CONNECTOR_TOKEN=replace-with-a-random-secret-of-32-or-more-chars

# no lark credentials live here. each tenant sends their own app id, app secret,
# and base app_token on every request; the connector stores none of them.
