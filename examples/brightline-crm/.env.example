# all optional; local-docker defaults shown

# the schema the catalog's tables live in
CONNECTOR_SCHEMA=crm
CONNECTOR_PORT=4100
# the protocol requires a bearer of at least 32 characters
ATLAS_CONNECTOR_TOKEN=brightline-dev-token-0123456789abcdef

# only `bun run seed` reads this. the connector takes the database url from the
# credentials on each request, so a tenant's database never appears in its env
CONNECTOR_DATABASE_URL=postgres://postgres:postgres@localhost:5434/brightline
