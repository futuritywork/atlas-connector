# copy to .env and fill in

# port the connector listens on; PORT takes precedence when both are set
CONNECTOR_PORT=4100

# the bearer Atlas presents on every POST. MUST be at least 32 characters — the server refuses
# to boot otherwise. generate one with: openssl rand -hex 24
ATLAS_CONNECTOR_TOKEN=

# ESB username and password are never environment configuration. Each tenant sends its own
# request-scoped credentials in the shape src/capability.ts declares.
