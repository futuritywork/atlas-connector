# copy to .env and fill in

# port the connector listens on
CONNECTOR_PORT=4100

# the bearer Atlas presents on every POST; under 32 characters the server refuses to boot (openssl rand -hex 24)
ATLAS_CONNECTOR_TOKEN=replace-with-a-random-secret-of-32-or-more-chars

# schema your catalog's tables live in
CONNECTOR_SCHEMA=public

# no connection string here: each tenant sends their own databaseUrl on every request
